# ── xpacenet node configuration ──────────────────────────────────────────────
# Copy to .env and fill in your values before running start.sh

# Public IP or domain of this machine (used for multiaddr announcement).
# Leave as 0.0.0.0 for local/LAN use only.
NODE_HOST=0.0.0.0

# Ports (must be open in your firewall / VPS security group)
NODE_TCP_PORT=4001    # libp2p TCP  — for other xpacenet nodes
NODE_WS_PORT=4002     # WebSocket   — for browser clients + other nodes
NODE_API_PORT=3000    # HTTP API    — room discovery, health check

# Optional: comma-separated multiaddrs of other xpacenet bootstrap nodes
# Example: /ip4/1.2.3.4/tcp/4001/p2p/12D3KooWxxx,/ip4/5.6.7.8/tcp/4001/p2p/12D3KooWyyy
BOOTSTRAP_PEERS=

# How long (ms) before an idle peer is pruned from a room
PEER_TTL_MS=90000

# Max WebSocket clients per node (prevent resource exhaustion)
MAX_WS_CLIENTS=500
