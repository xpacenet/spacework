{
  "name": "xpacenet",
  "version": "0.1.0",
  "description": "Lightweight P2P routing node — moves signed messages, never reads content",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev":   "node --watch src/index.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "libp2p":                        "^2.4.2",
    "@chainsafe/libp2p-gossipsub":   "^14.1.0",
    "@chainsafe/libp2p-noise":       "^16.0.0",
    "@chainsafe/libp2p-yamux":       "^7.0.1",
    "@libp2p/circuit-relay-v2":      "^3.1.0",
    "@libp2p/identify":              "^3.0.0",
    "@libp2p/kad-dht":               "^14.0.0",
    "@libp2p/tcp":                   "^10.0.0",
    "@libp2p/websockets":            "^9.0.0",
    "@libp2p/peer-id-factory":       "^4.2.4",
    "@libp2p/crypto":                "^5.0.6",
    "uint8arrays":                   "^5.1.0",
    "cors":                          "^2.8.5",
    "express":                       "^4.19.2",
    "ws":                            "^8.17.1"
  }
}
