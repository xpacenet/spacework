# ── xpacenode configuration ───────────────────────────────────────────────────
# Copy this to .env before running start.sh

# Public IP or hostname of this machine.
# Used so other nodes in the network can reach you.
# Leave as 0.0.0.0 for local/LAN testing only.
NODE_HOST=0.0.0.0

# Ports — open these in your firewall / VPS security group
NODE_TCP_PORT=4001     # libp2p TCP  (node ↔ node)
NODE_WS_PORT=4002      # WebSocket   (browser clients + nodes)
NODE_API_PORT=3000     # HTTP API    (/health  /info  /rooms)

# Other xpacenode bootstrap peers to connect to on startup.
# Comma-separated libp2p multiaddrs. Leave blank to run standalone.
# Example: /ip4/1.2.3.4/tcp/4001/p2p/12D3KooWabc...,/ip4/5.6.7.8/tcp/4001/p2p/12D3KooWxyz...
BOOTSTRAP_PEERS=

# Seconds before an idle peer is pruned from a room (2 missed heartbeats)
PEER_TTL_MS=90000

# Max concurrent WebSocket client connections (resource guard)
MAX_WS_CLIENTS=500

# Persistent data directory inside the container (mapped to a Docker volume)
DATA_DIR=/data
